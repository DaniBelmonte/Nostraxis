{
  "name": "nostraxis",
  "version": "0.1.0",
  "description": "A local-first observability dashboard for Codex, Claude Code and GitHub Copilot CLI sessions.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Daniel Belmonte Valero",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaniBelmonte/Nostraxis.git"
  },
  "bugs": {
    "url": "https://github.com/DaniBelmonte/Nostraxis/issues"
  },
  "homepage": "https://github.com/DaniBelmonte/Nostraxis#readme",
  "keywords": [
    "ai-agents",
    "codex",
    "claude-code",
    "copilot",
    "developer-tools",
    "local-first",
    "observability"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node server/start.mjs --dev",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "start": "node server/start.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "8.3.0"
  }
}
